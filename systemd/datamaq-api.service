[Unit]
Description=Datamaq Telemetry API Service
After=network.target mariadb.service mysql.service mosquitto.service

[Service]
Type=simple
User=agustin
WorkingDirectory=/home/agustin/proyectos_software/datamaq-telemetry
EnvironmentFile=/home/agustin/proyectos_software/datamaq-telemetry/.env
ExecStart=/home/agustin/proyectos_software/datamaq-telemetry/.venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
