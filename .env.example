# Datamaq Telemetry Environment Configuration

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=datamaq_telemetry

# MQTT Broker Configuration
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=datamaq-telemetry-backend
MQTT_TOPIC_PREFIX=m/wifi/#
MQTT_TLS_ENABLED=True
# CA raíz del broker (Let's Encrypt => ISRG Root X1). Vacío = usa el almacén de CAs del sistema.
# El worker corre en el mismo host que Mosquitto; con TLS el hostname del certificado
# (mqtt.datamaq.com.ar) debe coincidir. Usar MQTT_BROKER_HOST=mqtt.datamaq.com.ar y
# añadir "127.0.0.1 mqtt.datamaq.com.ar" a /etc/hosts para no salir a internet.
MQTT_TLS_CA_CERTS=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=
# Clave HMAC de los códigos OTP de cambio de contraseña. Obligatoria en producción (>=16 caracteres,
# distinta de API_SECRET_KEY). Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_HMAC_KEY=
AUTH_REQUIRED=True
APP_ENV=production
DEBUG=False
CORS_ORIGINS=
DEFAULT_USER_PASSWORD=Contraseña123

# Tuya / Smart Life (integración GF-SMBOX-PLUS, alivio de carga)
# Access ID/Secret: crear proyecto en https://iot.tuya.com (Cloud Project),
# luego vincular la cuenta Smart Life vía "Link Tuya App Account" (QR).
TUYA_API_REGION=sa
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_EMAIL=
TUYA_PASSWORD=

# Mercado Pago (suscripciones recurrentes / preapproval)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BASE_URL=https://api.mercadopago.com
MP_BACK_URL_EXITO=https://app.datamaq.com.ar/facturacion?estado=ok

# Billing - SaaS Gratuito (D1-D5: 2026-09-24)
# Si es False, todas las cuentas actúan como PRO ilimitado (retención sin límite, intervalo 0, notificaciones ON).
# Los endpoints de checkout y webhooks de Mercado Pago responden 503 Service Unavailable.
BILLING_HABILITADO=True

# Conectividad de dispositivos (#19)
# Un dispositivo activo sin datos durante este lapso pasa a OFFLINE (3 x el intervalo normal de 300 s).
DISPOSITIVO_OFFLINE_TIMEOUT_S=900
# Abre además la alerta PÉRDIDA_COMUNICACIÓN. Apagada hasta que el dueño apruebe su texto y su activación.
DISPOSITIVO_OFFLINE_ALERTA_HABILITADA=False
