[Unit]
Description=Datamaq Telemetry Inferred Load Signature Discovery
After=network.target mariadb.service mysql.service

[Service]
Type=oneshot
User=agustin
WorkingDirectory=/home/agustin/proyectos_software/datamaq-telemetry
EnvironmentFile=/home/agustin/proyectos_software/datamaq-telemetry/.env
ExecStart=/home/agustin/proyectos_software/datamaq-telemetry/.venv/bin/python scripts/proponer_firmas.py --dias 30
TimeoutStartSec=1800
